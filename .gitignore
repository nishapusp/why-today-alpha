# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Share cards are generated at build time, never committed
/public/cards/

# Remotion video-render workspace — its own node_modules (npm workspaces
# don't collapse a nested one when versions conflict with the root), and
# rendered videos are generated output, uploaded to Netlify Blobs, never committed
/remotion/node_modules
/remotion/out/
